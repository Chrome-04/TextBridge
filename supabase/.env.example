# Backend-only template. Copy to an ignored secrets file, never VITE_ variables.
# Supabase injects its own backend API key; do not copy one into browser code.
TEXTBRIDGE_MODE=live
TEXTBRIDGE_LIVE_ENABLED=false
TEXTBRIDGE_RATE_SALT=GENERATE_A_PRIVATE_RANDOM_VALUE
TEXTBRIDGE_CLEANUP_SECRET=GENERATE_A_DIFFERENT_PRIVATE_RANDOM_VALUE
TEXTBRIDGE_ORIGIN=https://YOUR_PROJECT_ID.web.app,https://YOUR_PROJECT_ID.firebaseapp.com
TEXTBRIDGE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
TEXTBRIDGE_FIREBASE_PROJECT_NUMBER=YOUR_PROJECT_NUMBER
TEXTBRIDGE_FIREBASE_APP_ID=YOUR_WEB_APP_ID
