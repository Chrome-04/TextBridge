# Copy to ignored .env.production.local. Public browser configuration only.
# Firebase API keys and App Check site keys are public; never add admin secrets.
VITE_SHARE_MODE=supabase
VITE_SHARE_STAGE=live
VITE_SUPABASE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/api
VITE_FIREBASE_API_KEY=YOUR_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_WEB_APP_ID
VITE_FIREBASE_APPCHECK_SITE_KEY=YOUR_SITE_KEY
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
