# Default: local Supabase on this computer. No cloud credentials needed.
VITE_SHARE_MODE=supabase
# Use demo only to revisit the older browser-local prototype.
# VITE_SHARE_MODE=demo
# Never place administrator keys or credentials in VITE_ variables.
# Saved notes use local Firebase Auth/Firestore emulators in this preview:
# npm run notes:emulators (see SAVED_NOTES_SETUP.md).

# Legacy Firebase emulator mode remains available:
# VITE_SHARE_MODE=firebase
