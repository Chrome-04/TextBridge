{
  "name": "textbridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "supabase:start": "node scripts/supabase.mjs start",
    "supabase:stop": "node scripts/supabase.mjs stop",
    "supabase:status": "node scripts/supabase.mjs status",
    "supabase:cleanup": "node scripts/supabase-cleanup.mjs",
    "test:supabase": "node scripts/supabase.mjs status && TEXTBRIDGE_SUPABASE_TEST=1 node --experimental-strip-types --test --test-concurrency=1 tests/supabase-integration.mjs && playwright test --config=playwright.supabase.config.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write src tests functions scripts supabase/functions vite.config.ts playwright.config.ts playwright.firebase.config.ts playwright.supabase.config.ts tsconfig.supabase.json",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.supabase.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "emulators": "node scripts/emulators.mjs",
    "test:backend": "node scripts/emulators.mjs test",
    "cleanup:local": "GCLOUD_PROJECT=demo-textbridge FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 node functions/cleanup.js"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "firebase-tools": "^15.35.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postgres": "^4.0.0",
    "prettier": "^3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
